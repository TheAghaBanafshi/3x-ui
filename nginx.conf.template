worker_processes 1;
events { worker_connections 1024; }

http {
    server {
        listen ${NGINX_PORT};

        # مسیر پنل وب (فوروارد به پورت داخلی 2053 که x-ui روش گوش می‌ده)
        location /panel {
            proxy_pass http://127.0.0.1:2053/panel;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # مسیر اصلی ساب: اپ‌های VPN متن خام می‌گیرن، مرورگر صفحه‌ی زیبا می‌بینه
        location /sub/ {
            if ($is_client_app = 1) {
                proxy_pass http://127.0.0.1:2096;
                break;
            }
            root /usr/share/nginx/html;
            try_files /view/index.html =404;
        }

        # مسیر داخلی که همیشه خام برمی‌گردونه (فقط برای fetch جاوااسکریپت صفحه‌ی زیبا)
        location /rawsub/ {
            proxy_pass http://127.0.0.1:2096/sub/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # صفحه‌ی نمایش زیبای ساب (کارت + QR + کپی) - برای وارد کردن دستی لینک
        location /view/ {
            alias /usr/share/nginx/html/view/;
            index index.html;
        }

        # هر مسیر دیگه (اینباند VLESS/WebSocket) به پورت داخلی 8080
        location / {
            proxy_pass http://127.0.0.1:8080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
